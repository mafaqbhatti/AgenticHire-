# Copy this to backend/.env and fill in your values

# Database (Docker local)
DATABASE_URL="postgresql://admin:hireflow_secret@localhost:5432/hireflow"

# Redis (Docker local)
REDIS_URL="redis://localhost:6379"

# Kafka (Docker local)
KAFKA_BROKER="localhost:9092"

# JWT
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"
JWT_EXPIRES_IN="7d"

# Groq AI - Get free key at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Email (use Gmail App Password or Mailtrap for dev)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_app_password"
EMAIL_FROM="HireFlow <your_email@gmail.com>"

# Encryption
ENCRYPTION_KEY="12345678901234567890123456789012"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
